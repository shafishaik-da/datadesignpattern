        <mxCell id="wjOKCcDqQDnaYY2_XeNC-84" parent="1" style="text;whiteSpace=wrap;html=1;" value="central data platform/engineering team&lt;div&gt;business domains often don’t own their datasets end-to-end&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Medallion is a pattern inside a platform&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;It can lead to copying everything into one place and over-centralizing.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="430" x="835" y="-485" as="geometry" />
